<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>myView</AssemblyName>
    <Title>myView - Ultra-Fast Image Viewer</Title>
    <Product>myView</Product>
    <Version>1.0.2</Version>
    <Company>myView</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app_icon_256.png" />
    <Resource Include="avatar.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>

</Project>
