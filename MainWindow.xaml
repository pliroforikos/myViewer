<Window x:Class="myView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="myView"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Icon="app.ico"
        AllowDrop="True"
        Focusable="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BgDarkBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Title Bar / Header Overlay (Row 0) -->
        <Border Grid.Row="0"
                x:Name="TopHeaderOverlay"
                Height="42"
                Background="#D9111116"
                BorderBrush="#252530"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Brand & Current File Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="myView" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Position Counter Pill -->
                    <Border x:Name="CounterBadge" Background="#232330" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="TxtCounter" Text="0 / 0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>

                    <!-- File Name -->
                    <TextBlock x:Name="TxtFileName" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>

                <!-- Center: Image Dimensions, File Size & Decode Speed -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="PillMetaInfo" Background="#1A1A24" CornerRadius="12" Padding="12,3" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtResolution" Text="" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="•" FontSize="11.5" Foreground="#555566" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtFileSize" Text="" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="•" FontSize="11.5" Foreground="#555566" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtFormat" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="•" FontSize="11.5" Foreground="#555566" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtSpeed" Text="⚡ 0 ms" FontSize="11" Foreground="#10B981" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Sort Pill & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- About / Περί Button -->
                    <Button x:Name="BtnAbout"
                            Click="BtnAbout_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="#1F1F2B"
                            BorderBrush="#333345"
                            BorderThickness="1"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Padding="10,3"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip="Περί myView (F1)">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ Περί" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Sort Mode Button -->
                    <Button x:Name="BtnSortMode"
                            Click="BtnSort_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="#1F1F2B"
                            BorderBrush="#333345"
                            BorderThickness="1"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Padding="10,3"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ToolTip="Sort Order (Press 'S' to cycle)">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSort}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtSortMode" Text="Name ▲" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Window Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBarButton}" Click="BtnMinimize_Click" ToolTip="Minimize">
                            <Path Data="{StaticResource IconMinimize}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Click="BtnMaximize_Click" ToolTip="Maximize">
                            <Path x:Name="PathMaximize" Data="{StaticResource IconMaximize}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" Click="BtnClose_Click" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Area (Row 1) -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <!-- Main Viewport for Image Display -->
            <Border x:Name="ViewportBorder"
                    Background="#0A0A0D"
                    ClipToBounds="True"
                    SizeChanged="ViewportBorder_SizeChanged"
                    MouseDown="Viewport_MouseDown"
                    MouseMove="Viewport_MouseMove"
                    MouseUp="Viewport_MouseUp"
                    MouseWheel="Viewport_MouseWheel">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📋 Αντιγραφή Εικόνας" InputGestureText="Ctrl+C" Click="BtnCopyImage_Click" />
                        <MenuItem Header="📁 Αντιγραφή Διαδρομής Αρχείου" InputGestureText="Ctrl+Shift+C" Click="MenuCopyFilePath_Click" />
                        <Separator />
                        <MenuItem Header="✂️ Περικοπή (Crop)" InputGestureText="C" Click="BtnCrop_Click" />
                        <MenuItem Header="📐 Ίσιωμα Ορίζοντα" InputGestureText="E" Click="BtnHorizon_Click" />
                        <MenuItem Header="📐 Προοπτική &amp; Skew" InputGestureText="P" Click="BtnPerspective_Click" />
                        <Separator />
                        <MenuItem Header="🔄 Περιστροφή Δεξιά 90°" InputGestureText="R" Click="BtnRotateRight_Click" />
                        <MenuItem Header="🔄 Περιστροφή Αριστερά 90°" InputGestureText="L" Click="BtnRotateLeft_Click" />
                        <MenuItem Header="↔️ Οριζόντια Αναστροφή" InputGestureText="H" Click="BtnFlipH_Click" />
                        <Separator />
                        <MenuItem Header="ℹ️ Πληροφορίες EXIF" InputGestureText="I" Click="BtnExif_Click" />
                        <MenuItem Header="⚙️ Περί &amp; Προεπιλογές" InputGestureText="F1" Click="BtnAbout_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Canvas x:Name="ImageCanvas" ClipToBounds="False">
                    <Image x:Name="DisplayImage"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Aliased"
                           Stretch="Fill">
                        <Image.RenderTransform>
                            <MatrixTransform x:Name="ImageMatrixTransform" />
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
            </Border>

            <!-- Empty State / Welcome Screen (Shown when no image is loaded) -->
            <Border x:Name="EmptyStateOverlay"
                    Background="#101015"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Border Width="96" Height="96" CornerRadius="24" Background="#1C1C24" BorderBrush="#2F2F3D" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image Source="app_icon_256.png" Width="72" Height="72" />
                    </Border>
                    <TextBlock Text="myView" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Ultra-Fast Lightweight Image Viewer" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    
                    <Button Click="BtnOpen_Click"
                            Padding="24,12"
                            Background="#00D2FF"
                            Foreground="#000000"
                            FontWeight="SemiBold"
                            FontSize="14"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Fill="#000000" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" />
                            <TextBlock Text="Open Image (Ctrl + O)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Drag and drop any image or folder here" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="Supported: JPG, PNG, BMP, RAW (CR2, NEF, ARW, DNG, etc.), PSD/PSB, SVG Vector"
                               FontSize="11.5" Foreground="#4B5563" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        <!-- Floating Bottom HUD Bar (Auto-hiding overlay) -->
        <Border x:Name="BottomHudBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="8,5"
                MouseEnter="BottomHud_MouseEnter"
                MouseLeave="BottomHud_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Navigation -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnFirst_Click" ToolTip="First Image (Home)">
                    <Path Data="{StaticResource IconFirst}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnPrev_Click" ToolTip="Previous Image (Left Arrow)">
                    <Path Data="{StaticResource IconPrev}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" />
                </Button>

                <!-- Navigation Index Display in HUD -->
                <TextBlock x:Name="TxtHudIndex" Text="0 / 0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" />

                <Button Style="{StaticResource HudIconButton}" Click="BtnNext_Click" ToolTip="Next Image (Right Arrow)">
                    <Path Data="{StaticResource IconNext}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnLast_Click" ToolTip="Last Image (End)">
                    <Path Data="{StaticResource IconLast}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Divider -->
                <Rectangle Width="1" Height="20" Fill="#2E2E3C" Margin="6,0" />

                <!-- Zoom Controls -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnZoomOut_Click" ToolTip="Zoom Out (-)">
                    <Path Data="{StaticResource IconZoomOut}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Button Click="BtnZoomReset_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Reset to 100% (1)"
                        Margin="2,0">
                    <Border Background="#222230" CornerRadius="12" Padding="8,4">
                        <TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </Button>

                <Button Style="{StaticResource HudIconButton}" Click="BtnZoomIn_Click" ToolTip="Zoom In (+)">
                    <Path Data="{StaticResource IconZoomIn}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnFit_Click" ToolTip="Fit to Screen (F)">
                    <Path Data="{StaticResource IconFit}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnNative_Click" ToolTip="1:1 Actual Size (1)">
                    <Path Data="{StaticResource IconNative}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Divider -->
                <Rectangle Width="1" Height="20" Fill="#2E2E3C" Margin="6,0" />

                <!-- Rotate & Flip -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnRotateLeft_Click" ToolTip="Rotate Left 90° (L)">
                    <Path Data="{StaticResource IconRotateLeft}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnRotateRight_Click" ToolTip="Rotate Right 90° (R)">
                    <Path Data="{StaticResource IconRotateRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnFlipH_Click" ToolTip="Flip Horizontal (H)">
                    <Path Data="{StaticResource IconFlipH}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Copy Image to Clipboard -->
                <Button x:Name="BtnCopyImage" Style="{StaticResource HudIconButton}" Click="BtnCopyImage_Click" ToolTip="Αντιγραφή Εικόνας στο Πρόχειρο (Ctrl+C)">
                    <Path Data="{StaticResource IconCopy}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Crop Mode Toggle -->
                <Button x:Name="BtnCropToggle" Style="{StaticResource HudIconButton}" Click="BtnCrop_Click" ToolTip="Crop Image / Περικοπή (C)">
                    <Path Data="{StaticResource IconCrop}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Straighten / Horizon Toggle -->
                <Button x:Name="BtnHorizonToggle" Style="{StaticResource HudIconButton}" Click="BtnHorizon_Click" ToolTip="Ευθυγράμμιση Ορίζοντα / Περιστροφή (E)">
                    <Path Data="{StaticResource IconHorizon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Perspective / Document Skew Toggle -->
                <Button x:Name="BtnPerspectiveToggle" Style="{StaticResource HudIconButton}" Click="BtnPerspective_Click" ToolTip="Διόρθωση Προοπτικής &amp; Skew Εγγράφου (P)">
                    <Path Data="{StaticResource IconPerspective}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Divider -->
                <Rectangle Width="1" Height="20" Fill="#2E2E3C" Margin="6,0" />

                <!-- EXIF Toggle -->
                <Button x:Name="BtnExifToggle" Style="{StaticResource HudIconButton}" Click="BtnExif_Click" ToolTip="Toggle EXIF Metadata (I)">
                    <Path Data="{StaticResource IconExif}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Fullscreen Toggle -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnFullscreen_Click" ToolTip="Toggle Fullscreen (F11)">
                    <Path Data="{StaticResource IconFullscreen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Open File -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnOpen_Click" ToolTip="Open Image (Ctrl+O)">
                    <Path Data="{StaticResource IconFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Floating EXIF Sidebar / Overlay (Right Side) -->
        <Border x:Name="ExifSidebar"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="380"
                Margin="0"
                Background="#EB111116"
                BorderBrush="#292938"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.5" />
            </Border.Effect>

            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconExif}" Fill="{StaticResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="EXIF &amp; Metadata" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource HudIconButton}" Width="30" Height="30" Click="BtnCopyExif_Click" ToolTip="Copy all metadata to clipboard" Margin="0,0,6,0">
                        <Path Data="{StaticResource IconCopy}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource HudIconButton}" Width="30" Height="30" Click="BtnCloseExif_Click" ToolTip="Close (Esc or I)">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <!-- Camera & Exposure Card -->
                        <Border Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CAMERA &amp; SHOT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                                <TextBlock x:Name="ExifCameraModel" Text="Unknown Camera" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" TextWrapping="Wrap" />
                                <TextBlock x:Name="ExifLensModel" Text="Unknown Lens" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <!-- Exposure Badges WrapPanel -->
                                <WrapPanel Margin="0,0,0,6">
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifShutter" Text="1/250s" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" />
                                    </Border>
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifAperture" Text="f/2.8" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" />
                                    </Border>
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifIso" Text="ISO 100" FontSize="12" FontWeight="SemiBold" Foreground="#FBBF24" />
                                    </Border>
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifFocal" Text="50mm" FontSize="12" FontWeight="SemiBold" Foreground="#F472B6" />
                                    </Border>
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifBias" Text="0 EV" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </WrapPanel>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Date Shot:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="ExifDateTaken" Grid.Column="1" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Image File Info Card -->
                        <Border Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="FILE &amp; DIMENSIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,3">
                                    <TextBlock Text="Dimensions" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifDimensions" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Megapixels" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifMegapixels" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Aspect Ratio" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifAspectRatio" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="File Size" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifFileSize" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Format" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifFormat" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Color Space" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifColorSpace" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Additional Shooting Conditions Card -->
                        <Border Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="SHOOTING CONDITIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,3">
                                    <TextBlock Text="Flash" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifFlash" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="White Balance" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifWhiteBalance" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Metering" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifMetering" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Program" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifProgram" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GPS Location Card -->
                        <Border x:Name="CardGps" Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="GPS LOCATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />
                                <TextBlock x:Name="ExifGpsCoords" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <Button Click="BtnOpenMap_Click"
                                        Background="#252536"
                                        Foreground="{StaticResource AccentBrush}"
                                        BorderThickness="0"
                                        Padding="12,6"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconMap}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                        <TextBlock Text="View on Google Maps" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Complete Raw Tag Tree (All Tags Explorer) -->
                        <Border Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ALL METADATA TAGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                                <TextBox x:Name="TxtTagSearch"
                                         TextChanged="TxtTagSearch_TextChanged"
                                         Background="#20202C"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="#333346"
                                         BorderThickness="1"
                                         Padding="8,5"
                                         FontSize="12"
                                         Margin="0,0,0,10" />

                                <ItemsControl x:Name="ItemsExifGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding DirectoryName}" IsExpanded="False" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6">
                                                <ItemsControl ItemsSource="{Binding Tags}" Margin="8,4,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="130" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding TagName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TagName}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding TagValue}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Loading Spinner Indicator (Non-blocking, top right) -->
        <Border x:Name="LoadingBadge"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,24,0"
                Background="#D91E1E28"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12,6"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡ Loading..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Border>

        <!-- Crop Interactive Overlay (Covers the Viewport) -->
        <Canvas x:Name="CropCanvas"
                Visibility="Collapsed"
                Background="Transparent"
                ClipToBounds="True"
                MouseDown="CropCanvas_MouseDown"
                MouseMove="CropCanvas_MouseMove"
                MouseUp="CropCanvas_MouseUp">

            <!-- 4 Dark Dimmed Shades (outside crop rectangle) -->
            <Rectangle x:Name="CropShadeTop" Fill="#99000000" />
            <Rectangle x:Name="CropShadeBottom" Fill="#99000000" />
            <Rectangle x:Name="CropShadeLeft" Fill="#99000000" />
            <Rectangle x:Name="CropShadeRight" Fill="#99000000" />

            <!-- The Active Crop Selection Box -->
            <Border x:Name="CropBox"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5"
                    Background="#0500D2FF"
                    Cursor="SizeAll">
                <Grid>
                    <!-- Rule-of-thirds grid guides -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Column="1" Grid.RowSpan="3" Width="1" HorizontalAlignment="Left" Fill="#26FFFFFF" />
                    <Rectangle Grid.Column="1" Grid.RowSpan="3" Width="1" HorizontalAlignment="Right" Fill="#26FFFFFF" />
                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="#26FFFFFF" />
                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="#26FFFFFF" />
                </Grid>
            </Border>

            <!-- 8 Resize Handles -->
            <Rectangle x:Name="HandleNW" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1" Cursor="SizeNWSE" />
            <Rectangle x:Name="HandleNE" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1" Cursor="SizeNESW" />
            <Rectangle x:Name="HandleSW" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1" Cursor="SizeNESW" />
            <Rectangle x:Name="HandleSE" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1" Cursor="SizeNWSE" />
            <Rectangle x:Name="HandleN"  Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1" Cursor="SizeNS" />
            <Rectangle x:Name="HandleS"  Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1" Cursor="SizeNS" />
            <Rectangle x:Name="HandleW"  Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1" Cursor="SizeWE" />
            <Rectangle x:Name="HandleE"  Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1" Cursor="SizeWE" />
        </Canvas>

        <!-- Floating Crop Toolbar -->
        <Border x:Name="CropToolbar"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Background="#F013131A"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="16,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Mode Title & Dimensions Pill -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Path Data="{StaticResource IconCrop}" Fill="{StaticResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Περικοπή:" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Border Background="#20202E" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCropDimensions" Text="0 × 0 px" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Width="1" Height="20" Fill="#2E2E3C" Margin="0,0,12,0" />

                <!-- Save As Button -->
                <Button x:Name="BtnCropSaveAs"
                        Click="BtnCropSaveAs_Click"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#000000"
                        FontWeight="Bold"
                        FontSize="12"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        ToolTip="Αποθήκευση με νέο όνομα αρχείου (ή επιλογή αρχείου)">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSave}" Fill="#000000" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Αποθήκευση ως..." VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Overwrite Button -->
                <Button x:Name="BtnCropOverwrite"
                        Click="BtnCropOverwrite_Click"
                        Background="#252538"
                        BorderBrush="#FF8C00"
                        BorderThickness="1"
                        Foreground="#FFB040"
                        FontWeight="SemiBold"
                        FontSize="12"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        ToolTip="Άμεση αντικατάσταση του αρχικού αρχείου">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ Αντικατάσταση" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button x:Name="BtnCropCancel"
                        Click="BtnCropCancel_Click"
                        Background="Transparent"
                        BorderBrush="#38384C"
                        BorderThickness="1"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontWeight="SemiBold"
                        FontSize="12"
                        Padding="12,6"
                        Cursor="Hand"
                        ToolTip="Ακύρωση περικοπής (Esc)">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                    </Button.Resources>
                    <TextBlock Text="Ακύρωση" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Horizon / Straighten Interactive Overlay -->
        <Canvas x:Name="HorizonCanvas"
                Visibility="Collapsed"
                Background="Transparent"
                ClipToBounds="True"
                MouseDown="HorizonCanvas_MouseDown"
                MouseMove="HorizonCanvas_MouseMove"
                MouseUp="HorizonCanvas_MouseUp">

            <!-- Full-viewport alignment grid lines -->
            <Canvas x:Name="HorizonGridCanvas" IsHitTestVisible="False" Opacity="0.35" />

            <!-- Virtual Horizon Reference Line -->
            <Line x:Name="HorizonRefLine"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="2"
                  StrokeDashArray="4 2" />

            <!-- Left and Right draggable horizon anchor handles -->
            <Grid x:Name="HorizonAnchorLeft" Width="26" Height="26" Cursor="Hand" Margin="-13,-13,0,0">
                <Ellipse Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1.5" />
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" />
            </Grid>
            <Grid x:Name="HorizonAnchorRight" Width="26" Height="26" Cursor="Hand" Margin="-13,-13,0,0">
                <Ellipse Fill="{StaticResource AccentBrush}" Stroke="#000000" StrokeThickness="1.5" />
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" />
            </Grid>

            <!-- Angle readout badge floating along the line -->
            <Border x:Name="HorizonCenterBadge"
                    Background="#EB121218"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,4"
                    IsHitTestVisible="False"
                    Margin="-30,-15,0,0">
                <TextBlock x:Name="TxtHorizonCenterAngle" Text="0.0°" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            </Border>
        </Canvas>

        <!-- Floating Horizon Toolbar -->
        <Border x:Name="HorizonToolbar"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Background="#F013131A"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="16,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconHorizon}" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Ορίζοντας:" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                <!-- Nudge Minus -->
                <Button Click="BtnHorizonMinus_Click" Style="{StaticResource HudIconButton}" Width="26" Height="26" ToolTip="-0.5°" Margin="0,0,4,0">
                    <TextBlock Text="-0.5°" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>

                <!-- Slider -->
                <Slider x:Name="SliderHorizonAngle"
                        Minimum="-45"
                        Maximum="45"
                        Value="0"
                        Width="140"
                        VerticalAlignment="Center"
                        TickFrequency="0.5"
                        IsSnapToTickEnabled="False"
                        ValueChanged="SliderHorizonAngle_ValueChanged"
                        Margin="0,0,4,0" />

                <!-- Nudge Plus -->
                <Button Click="BtnHorizonPlus_Click" Style="{StaticResource HudIconButton}" Width="26" Height="26" ToolTip="+0.5°" Margin="0,0,6,0">
                    <TextBlock Text="+0.5°" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>

                <!-- Angle display pill & Reset -->
                <Button Click="BtnHorizonReset_Click" Background="#20202E" BorderBrush="#333346" BorderThickness="1" Padding="8,3" Cursor="Hand" ToolTip="Επαναφορά σε 0.0°" Margin="0,0,10,0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                    <TextBlock x:Name="TxtHorizonAngle" Text="0.0°" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </Button>

                <!-- Auto Crop Checkbox -->
                <CheckBox x:Name="ChkHorizonAutoCrop" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5">
                    <TextBlock Text="Αυτόματο Crop" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </CheckBox>

                <Rectangle Width="1" Height="20" Fill="#2E2E3C" Margin="0,0,12,0" />

                <Button Click="BtnHorizonSaveAs_Click" Background="{StaticResource AccentBrush}" Foreground="#000000" FontWeight="Bold" FontSize="12" Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style></Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSave}" Fill="#000000" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Αποθήκευση ως..." VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="BtnHorizonOverwrite_Click" Background="#252538" BorderBrush="#FF8C00" BorderThickness="1" Foreground="#FFB040" FontWeight="SemiBold" FontSize="12" Padding="12,6" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style></Button.Resources>
                    <TextBlock Text="⚠️ Αντικατάσταση" VerticalAlignment="Center" />
                </Button>

                <Button Click="BtnHorizonCancel_Click" Background="Transparent" BorderBrush="#38384C" BorderThickness="1" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12" Padding="12,6" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style></Button.Resources>
                    <TextBlock Text="Ακύρωση" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Perspective / 4-Corner Document Skew Interactive Overlay -->
        <Canvas x:Name="PerspectiveCanvas"
                Visibility="Collapsed"
                Background="Transparent"
                ClipToBounds="False"
                MouseDown="PerspectiveCanvas_MouseDown"
                MouseMove="PerspectiveCanvas_MouseMove"
                MouseUp="PerspectiveCanvas_MouseUp">

            <!-- Shaded area outside the quadrilateral -->
            <Path x:Name="PerspectiveDarkShade" Fill="#55000000" />

            <!-- Perspective Guide Mesh (Lines inside the quad) -->
            <Path x:Name="PerspectiveMeshLines" Stroke="#5500D2FF" StrokeThickness="1" StrokeDashArray="3 3" />

            <!-- Polygon Border connecting the 4 corners -->
            <Path x:Name="PerspectiveQuadBorder" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />

            <!-- 4 Corner Draggable Handles -->
            <!-- Top-Left (TL) -->
            <Grid x:Name="HandleTL" Width="36" Height="36" Cursor="Cross" Margin="-18,-18,0,0">
                <Ellipse Fill="#E6101018" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" />
                <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-16,0,0">
                    <TextBlock Text="↖ TL (Άνοιγμα)" FontSize="9" FontWeight="Bold" Foreground="#000000" />
                </Border>
            </Grid>

            <!-- Top-Right (TR) -->
            <Grid x:Name="HandleTR" Width="36" Height="36" Cursor="Cross" Margin="-18,-18,0,0">
                <Ellipse Fill="#E6101018" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" />
                <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,-4,0">
                    <TextBlock Text="TR (Άνοιγμα) ↗" FontSize="9" FontWeight="Bold" Foreground="#000000" />
                </Border>
            </Grid>

            <!-- Bottom-Right (BR) -->
            <Grid x:Name="HandleBR" Width="36" Height="36" Cursor="Cross" Margin="-18,-18,0,0">
                <Ellipse Fill="#E6101018" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" />
                <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-16">
                    <TextBlock Text="BR ↘" FontSize="9" FontWeight="Bold" Foreground="#000000" />
                </Border>
            </Grid>

            <!-- Bottom-Left (BL) -->
            <Grid x:Name="HandleBL" Width="36" Height="36" Cursor="Cross" Margin="-18,-18,0,0">
                <Ellipse Fill="#E6101018" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" />
                <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-16">
                    <TextBlock Text="↙ BL" FontSize="9" FontWeight="Bold" Foreground="#000000" />
                </Border>
            </Grid>
        </Canvas>

        <!-- Floating Perspective Toolbar -->
        <Border x:Name="PerspectiveToolbar"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Background="#F013131A"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="16,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconPerspective}" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Προοπτική / Skew:" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                <!-- Mode Toggle (Keystone Warp vs Quad Crop) -->
                <Border Background="#20202E" CornerRadius="8" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnModeKeystone" Click="BtnModeKeystone_Click" Background="{StaticResource AccentBrush}" Foreground="#000000" FontWeight="Bold" FontSize="11" Padding="8,3" Cursor="Hand" ToolTip="Άνοιγμα / κλείσιμο γωνιών (Keystone)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            <TextBlock Text="↔️ Άνοιγμα" />
                        </Button>
                        <Button x:Name="BtnModeQuadCrop" Click="BtnModeQuadCrop_Click" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Normal" FontSize="11" Padding="8,3" Cursor="Hand" ToolTip="Επιλογή 4 γωνιών εγγράφου μέσα στην εικόνα">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            <TextBlock Text="✂️ Quad Crop" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Keystone Top Opening Slider & Controls -->
                <StackPanel x:Name="KeystoneSliderPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Άνοιγμα:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Click="BtnKeystoneDec_Click" Style="{StaticResource HudIconButton}" Width="22" Height="22" ToolTip="-1% (Στένεμα)" Margin="0,0,3,0">
                        <TextBlock Text="-" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                    <Slider x:Name="SliderKeystoneTop"
                            Minimum="-60"
                            Maximum="60"
                            Value="0"
                            Width="90"
                            SmallChange="1"
                            LargeChange="5"
                            VerticalAlignment="Center"
                            ValueChanged="SliderKeystoneTop_ValueChanged"
                            Margin="0,0,3,0" />
                    <Button Click="BtnKeystoneInc_Click" Style="{StaticResource HudIconButton}" Width="22" Height="22" ToolTip="+1% (Άνοιγμα)" Margin="0,0,6,0">
                        <TextBlock Text="+" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                    <Border Background="#20202E" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtKeystoneValue" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" MinWidth="28" TextAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Symmetric Checkbox -->
                <CheckBox x:Name="ChkPerspectiveSymmetric" IsChecked="True" Checked="ChkPerspective_SettingChanged" Unchecked="ChkPerspective_SettingChanged" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Συμμετρικό άνοιγμα/κλείσιμο και των δύο πλευρών ταυτόχρονα">
                    <TextBlock Text="Συμμετρικό" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" />
                </CheckBox>

                <!-- Auto-Crop Checkbox -->
                <CheckBox x:Name="ChkPerspectiveCrop" IsChecked="True" Checked="ChkPerspective_SettingChanged" Unchecked="ChkPerspective_SettingChanged" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Αυτόματη περικοπή στα καθαρά όρια (χωρίς κενά περιθώρια)">
                    <TextBlock Text="Περικοπή" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" />
                </CheckBox>

                <!-- Text Enhance Checkbox -->
                <CheckBox x:Name="ChkPerspectiveEnhance" IsChecked="False" Checked="ChkPerspective_SettingChanged" Unchecked="ChkPerspective_SettingChanged" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" ToolTip="Αύξηση αντίθεσης &amp; ευκρίνειας κειμένου">
                    <TextBlock Text="Βελτίωση" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </CheckBox>

                <!-- Reset Button -->
                <Button Click="BtnPerspectiveReset_Click" Background="#20202E" BorderBrush="#333346" BorderThickness="1" Padding="8,4" Cursor="Hand" ToolTip="Επαναφορά γωνιών στην αρχική θέση" Margin="0,0,10,0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                    <TextBlock Text="🔄 Reset" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>

                <Rectangle Width="1" Height="20" Fill="#2E2E3C" Margin="0,0,10,0" />

                <!-- Save As -->
                <Button Click="BtnPerspectiveSaveAs_Click" Background="{StaticResource AccentBrush}" Foreground="#000000" FontWeight="Bold" FontSize="12" Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style></Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSave}" Fill="#000000" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Αποθήκευση ως..." VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Overwrite -->
                <Button Click="BtnPerspectiveOverwrite_Click" Background="#252538" BorderBrush="#FF8C00" BorderThickness="1" Foreground="#FFB040" FontWeight="SemiBold" FontSize="12" Padding="12,6" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style></Button.Resources>
                    <TextBlock Text="⚠️ Αντικατάσταση" VerticalAlignment="Center" />
                </Button>

                <!-- Cancel -->
                <Button Click="BtnPerspectiveCancel_Click" Background="Transparent" BorderBrush="#38384C" BorderThickness="1" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12" Padding="12,6" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style></Button.Resources>
                    <TextBlock Text="Ακύρωση" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Toast Notification Badge (Auto-hiding success feedback) -->
        <Border x:Name="ToastBadge"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Background="#E610B981"
                CornerRadius="16"
                Padding="16,8"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtToastMessage" Text="✓ Η εικόνα αποθηκεύτηκε επιτυχώς!" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>

        <!-- About / Περί Modal Overlay (Spans entire window) -->
        <Border x:Name="AboutOverlay"
                Grid.Row="0" Grid.RowSpan="2"
                Panel.ZIndex="1000"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Background="#CC050508"
                Visibility="Collapsed"
                MouseDown="AboutOverlay_BackgroundMouseDown">
            <Border Background="#161622"
                    BorderBrush="#2C2C40"
                    BorderThickness="1.5"
                    CornerRadius="20"
                    MaxWidth="540"
                    Margin="24"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseDown="AboutCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.75" />
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#20202E" BorderBrush="#35354A" BorderThickness="1" Margin="0,0,12,0">
                            <Image Source="app_icon_256.png" Width="34" Height="34" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="myView" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                <Border Background="#252538" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="v1.0.6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Ultra-Fast Image &amp; Vector Viewer for Windows" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource HudIconButton}" Width="32" Height="32" Click="BtnCloseAbout_Click" ToolTip="Κλείσιμο (Esc)">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="#262636" Margin="0,0,0,16" />

                    <!-- Creator Profile Card -->
                    <Border Background="#1D1D28" CornerRadius="14" BorderBrush="#2C2C40" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Avatar from plarg.gr -->
                            <Border Grid.Column="0" Width="84" Height="84" CornerRadius="42" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Margin="0,0,16,0" VerticalAlignment="Center" ClipToBounds="True">
                                <Image Source="avatar.jpg" Stretch="UniformToFill" Width="84" Height="84" />
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Λέων Προκόπης" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                <TextBlock Text="Καθηγητής Πληροφορικής" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Εφαρμογές, εργαλεία και σημειώσεις πληροφορικής για τη διδασκαλία και την καθημερινότητα."
                                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <Button Click="BtnOpenPlarg_Click"
                                        Background="#262638"
                                        Foreground="{StaticResource AccentBrush}"
                                        BorderBrush="#383850"
                                        BorderThickness="1"
                                        Padding="10,4"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐 plarg.gr" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Default Apps Card -->
                    <Border Background="#1D1D28" CornerRadius="14" BorderBrush="#2C2C40" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Προεπιλεγμένη Εφαρμογή (Default Viewer)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtDefaultStatus"
                                           Text="Καταχώριση στα Windows και άνοιγμα ρυθμίσεων προεπιλογής για όλα τα υποστηριζόμενα αρχεία."
                                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Name="BtnSetAsDefault"
                                    Click="BtnSetAsDefault_Click"
                                    Background="#252538"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource AccentBrush}"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Padding="12,7"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtBtnSetAsDefault" Text="🛠️ Ορισμός ως Προεπιλογή" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- License Card (CC BY-NC 4.0) -->
                    <Border Background="#1D1D28" CornerRadius="14" BorderBrush="#2C2C40" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="⚖️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Άδεια Χρήσης: CC BY-NC 4.0" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Δωρεάν χρήση και διανομή για εκπαιδευτικούς σκοπούς, με αναφορά στον δημιουργό (Λέων Προκόπης) και χωρίς εμπορική χρήση."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,8" />

                            <Button Click="BtnOpenLicense_Click"
                                    Background="Transparent"
                                    Foreground="#60A5FA"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Padding="0">
                                <TextBlock Text="Creative Commons Attribution-NonCommercial 4.0 International ↗" FontSize="11" TextDecorations="Underline" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Button Click="BtnCloseAbout_Click"
                            Padding="24,9"
                            Background="{StaticResource AccentBrush}"
                            Foreground="#000000"
                            FontWeight="Bold"
                            FontSize="13"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Right">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10" /></Style>
                        </Button.Resources>
                        <TextBlock Text="Κλείσιμο" />
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
