; Script generated by Antigravity for myView
; Inno Setup 6 Script - Lightweight Edition (Framework Dependent)

#define MyAppName "myView (Lightweight)"
#define MyAppVersion "1.0.9"
#define MyAppPublisher "Λέων Προκόπης (plarg.gr)"
#define MyAppURL "https://plarg.gr"
#define MyAppExeName "myView.exe"

[Setup]
AppId={{50B129D2-38EE-464A-A909-66F5CF897EEA}
AppName=myView
AppVersion={#MyAppVersion}
AppVerName=myView {#MyAppVersion} (Lightweight)
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL=https://github.com/pliroforikos/myViewer/releases
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DefaultDirName={autopf}\myView
DefaultGroupName=myView
AllowNoIcons=yes
LicenseFile=..\LICENSE
OutputDir=..\dist
OutputBaseFilename=myView-v1.0.9-lightweight-setup
SetupIconFile=..\app.ico
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog commandline
UninstallDisplayIcon={app}\{#MyAppExeName}
ChangesAssociations=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "associmages"; Description: "Register myView for image files (.jpg, .png, .bmp, .svg, .psd, RAW, etc.)"; GroupDescription: "File Associations:"

[Files]
Source: "..\dist\myView-win-x64\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "*.pdb"
Source: "..\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\LICENSE"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\myView"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"
Name: "{group}\Documentation (README)"; Filename: "{app}\README.md"
Name: "{group}\License (CC BY-NC 4.0)"; Filename: "{app}\LICENSE"
Name: "{group}\{cm:ProgramOnTheWeb,{#MyAppPublisher}}"; Filename: "{#MyAppURL}"
Name: "{group}\{cm:UninstallProgram,myView}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\myView"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Registry]
; ProgID Definition
Root: HKA; Subkey: "Software\Classes\myView.Image"; ValueType: string; ValueName: ""; ValueData: "myView Image File"; Flags: uninsdeletekey; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\myView.Image"; ValueType: string; ValueName: "FriendlyTypeName"; ValueData: "myView Image File"; Flags: uninsdeletekey; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\myView.Image\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\myView.Image\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\myView.Image\shell\open"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "myView"; Tasks: associmages

; Applications Registration
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "myView"; Flags: uninsdeletekey; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Tasks: associmages

; Capabilities for Windows 10/11 Default Apps
Root: HKA; Subkey: "Software\myView\Capabilities"; ValueType: string; ValueName: "ApplicationDescription"; ValueData: "myView - Ultra-Fast Image & Vector Viewer for Windows"; Flags: uninsdeletekey; Tasks: associmages
Root: HKA; Subkey: "Software\myView\Capabilities"; ValueType: string; ValueName: "ApplicationName"; ValueData: "myView"; Tasks: associmages
Root: HKA; Subkey: "Software\myView\Capabilities"; ValueType: string; ValueName: "ApplicationIcon"; ValueData: "{app}\{#MyAppExeName},0"; Tasks: associmages
Root: HKA; Subkey: "Software\RegisteredApplications"; ValueType: string; ValueName: "myView"; ValueData: "Software\myView\Capabilities"; Flags: uninsdeletevalue; Tasks: associmages

; Capabilities FileAssociations
Root: HKA; Subkey: "Software\myView\Capabilities\FileAssociations"; ValueType: string; ValueName: ".jpg"; ValueData: "myView.Image"; Tasks: associmages
Root: HKA; Subkey: "Software\myView\Capabilities\FileAssociations"; ValueType: string; ValueName: ".jpeg"; ValueData: "myView.Image"; Tasks: associmages
Root: HKA; Subkey: "Software\myView\Capabilities\FileAssociations"; ValueType: string; ValueName: ".png"; ValueData: "myView.Image"; Tasks: associmages
Root: HKA; Subkey: "Software\myView\Capabilities\FileAssociations"; ValueType: string; ValueName: ".bmp"; ValueData: "myView.Image"; Tasks: associmages
Root: HKA; Subkey: "Software\myView\Capabilities\FileAssociations"; ValueType: string; ValueName: ".gif"; ValueData: "myView.Image"; Tasks: associmages
Root: HKA; Subkey: "Software\myView\Capabilities\FileAssociations"; ValueType: string; ValueName: ".webp"; ValueData: "myView.Image"; Tasks: associmages
Root: HKA; Subkey: "Software\myView\Capabilities\FileAssociations"; ValueType: string; ValueName: ".svg"; ValueData: "myView.Image"; Tasks: associmages
Root: HKA; Subkey: "Software\myView\Capabilities\FileAssociations"; ValueType: string; ValueName: ".psd"; ValueData: "myView.Image"; Tasks: associmages

; OpenWithProgids
Root: HKA; Subkey: "Software\Classes\.jpg\OpenWithProgids"; ValueType: string; ValueName: "myView.Image"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\.png\OpenWithProgids"; ValueType: string; ValueName: "myView.Image"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\.bmp\OpenWithProgids"; ValueType: string; ValueName: "myView.Image"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\.svg\OpenWithProgids"; ValueType: string; ValueName: "myView.Image"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associmages
Root: HKA; Subkey: "Software\Classes\.psd\OpenWithProgids"; ValueType: string; ValueName: "myView.Image"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associmages

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,myView}"; Flags: nowait postinstall skipifsilent; WorkingDir: "{app}"
