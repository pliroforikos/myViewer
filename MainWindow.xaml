<Window x:Class="myView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="myView"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Icon="app.ico"
        AllowDrop="True"
        Focusable="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BgDarkBrush}" ClipToBounds="True">
        <!-- Main Viewport for Image Display -->
        <Border x:Name="ViewportBorder"
                Background="#0A0A0D"
                ClipToBounds="True"
                MouseDown="Viewport_MouseDown"
                MouseMove="Viewport_MouseMove"
                MouseUp="Viewport_MouseUp"
                MouseWheel="Viewport_MouseWheel">
            <Canvas x:Name="ImageCanvas" ClipToBounds="True">
                <Image x:Name="DisplayImage"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderOptions.EdgeMode="Aliased"
                       Stretch="None">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="ImageRotate" Angle="0" />
                            <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>
        </Border>

        <!-- Empty State / Welcome Screen (Shown when no image is loaded) -->
        <Border x:Name="EmptyStateOverlay"
                Background="#101015"
                Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Border Width="96" Height="96" CornerRadius="24" Background="#1C1C24" BorderBrush="#2F2F3D" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Image Source="app_icon_256.png" Width="72" Height="72" />
                </Border>
                <TextBlock Text="myView" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Ultra-Fast Lightweight Image Viewer" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                
                <Button Click="BtnOpen_Click"
                        Padding="24,12"
                        Background="#00D2FF"
                        Foreground="#000000"
                        FontWeight="SemiBold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Fill="#000000" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" />
                        <TextBlock Text="Open Image (Ctrl + O)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Drag and drop any image or folder here" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="Supported: JPG, PNG, BMP, RAW (CR2, NEF, ARW, DNG, etc.), PSD/PSB, SVG Vector"
                           FontSize="11.5" Foreground="#4B5563" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Top Title Bar / Header Overlay -->
        <Border x:Name="TopHeaderOverlay"
                VerticalAlignment="Top"
                Height="42"
                Background="#D9111116"
                BorderBrush="#252530"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Brand & Current File Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="myView" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <!-- Position Counter Pill -->
                    <Border x:Name="CounterBadge" Background="#232330" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="TxtCounter" Text="0 / 0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>

                    <!-- File Name -->
                    <TextBlock x:Name="TxtFileName" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>

                <!-- Center: Image Dimensions, File Size & Decode Speed -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="PillMetaInfo" Background="#1A1A24" CornerRadius="12" Padding="12,3" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtResolution" Text="" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="•" FontSize="11.5" Foreground="#555566" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtFileSize" Text="" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="•" FontSize="11.5" Foreground="#555566" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtFormat" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="•" FontSize="11.5" Foreground="#555566" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtSpeed" Text="⚡ 0 ms" FontSize="11" Foreground="#10B981" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Sort Pill & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Sort Mode Button -->
                    <Button x:Name="BtnSortMode"
                            Click="BtnSort_Click"
                            Background="#1F1F2B"
                            BorderBrush="#333345"
                            BorderThickness="1"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Padding="10,3"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ToolTip="Sort Order (Press 'S' to cycle)">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSort}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtSortMode" Text="Name ▲" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Window Buttons -->
                    <StackPanel Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Click="BtnMinimize_Click" ToolTip="Minimize">
                            <Path Data="{StaticResource IconMinimize}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Click="BtnMaximize_Click" ToolTip="Maximize">
                            <Path x:Name="PathMaximize" Data="{StaticResource IconMaximize}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" Click="BtnClose_Click" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Floating Bottom HUD Bar (Auto-hiding overlay) -->
        <Border x:Name="BottomHudBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="8,5"
                MouseEnter="BottomHud_MouseEnter"
                MouseLeave="BottomHud_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Navigation -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnFirst_Click" ToolTip="First Image (Home)">
                    <Path Data="{StaticResource IconFirst}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnPrev_Click" ToolTip="Previous Image (Left Arrow)">
                    <Path Data="{StaticResource IconPrev}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" />
                </Button>

                <!-- Navigation Index Display in HUD -->
                <TextBlock x:Name="TxtHudIndex" Text="0 / 0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" />

                <Button Style="{StaticResource HudIconButton}" Click="BtnNext_Click" ToolTip="Next Image (Right Arrow)">
                    <Path Data="{StaticResource IconNext}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnLast_Click" ToolTip="Last Image (End)">
                    <Path Data="{StaticResource IconLast}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Divider -->
                <Rectangle Width="1" Height="20" Fill="#2E2E3C" Margin="6,0" />

                <!-- Zoom Controls -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnZoomOut_Click" ToolTip="Zoom Out (-)">
                    <Path Data="{StaticResource IconZoomOut}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Button Click="BtnZoomReset_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Reset to 100% (1)"
                        Margin="2,0">
                    <Border Background="#222230" CornerRadius="12" Padding="8,4">
                        <TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </Button>

                <Button Style="{StaticResource HudIconButton}" Click="BtnZoomIn_Click" ToolTip="Zoom In (+)">
                    <Path Data="{StaticResource IconZoomIn}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnFit_Click" ToolTip="Fit to Screen (F)">
                    <Path Data="{StaticResource IconFit}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnNative_Click" ToolTip="1:1 Actual Size (1)">
                    <Path Data="{StaticResource IconNative}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Divider -->
                <Rectangle Width="1" Height="20" Fill="#2E2E3C" Margin="6,0" />

                <!-- Rotate & Flip -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnRotateLeft_Click" ToolTip="Rotate Left 90° (L)">
                    <Path Data="{StaticResource IconRotateLeft}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnRotateRight_Click" ToolTip="Rotate Right 90° (R)">
                    <Path Data="{StaticResource IconRotateRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource HudIconButton}" Click="BtnFlipH_Click" ToolTip="Flip Horizontal (H)">
                    <Path Data="{StaticResource IconFlipH}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Divider -->
                <Rectangle Width="1" Height="20" Fill="#2E2E3C" Margin="6,0" />

                <!-- EXIF Toggle -->
                <Button x:Name="BtnExifToggle" Style="{StaticResource HudIconButton}" Click="BtnExif_Click" ToolTip="Toggle EXIF Metadata (I)">
                    <Path Data="{StaticResource IconExif}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Fullscreen Toggle -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnFullscreen_Click" ToolTip="Toggle Fullscreen (F11)">
                    <Path Data="{StaticResource IconFullscreen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Open File -->
                <Button Style="{StaticResource HudIconButton}" Click="BtnOpen_Click" ToolTip="Open Image (Ctrl+O)">
                    <Path Data="{StaticResource IconFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Floating EXIF Sidebar / Overlay (Right Side) -->
        <Border x:Name="ExifSidebar"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="380"
                Margin="0,42,0,0"
                Background="#EB111116"
                BorderBrush="#292938"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.5" />
            </Border.Effect>

            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconExif}" Fill="{StaticResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="EXIF &amp; Metadata" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource HudIconButton}" Width="30" Height="30" Click="BtnCopyExif_Click" ToolTip="Copy all metadata to clipboard" Margin="0,0,6,0">
                        <Path Data="{StaticResource IconCopy}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource HudIconButton}" Width="30" Height="30" Click="BtnCloseExif_Click" ToolTip="Close (Esc or I)">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <!-- Camera & Exposure Card -->
                        <Border Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CAMERA &amp; SHOT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                                <TextBlock x:Name="ExifCameraModel" Text="Unknown Camera" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" TextWrapping="Wrap" />
                                <TextBlock x:Name="ExifLensModel" Text="Unknown Lens" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <!-- Exposure Badges WrapPanel -->
                                <WrapPanel Margin="0,0,0,6">
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifShutter" Text="1/250s" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" />
                                    </Border>
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifAperture" Text="f/2.8" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" />
                                    </Border>
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifIso" Text="ISO 100" FontSize="12" FontWeight="SemiBold" Foreground="#FBBF24" />
                                    </Border>
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifFocal" Text="50mm" FontSize="12" FontWeight="SemiBold" Foreground="#F472B6" />
                                    </Border>
                                    <Border Background="#242434" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="ExifBias" Text="0 EV" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </WrapPanel>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Date Shot:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="ExifDateTaken" Grid.Column="1" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Image File Info Card -->
                        <Border Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="FILE &amp; DIMENSIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,3">
                                    <TextBlock Text="Dimensions" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifDimensions" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Megapixels" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifMegapixels" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Aspect Ratio" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifAspectRatio" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="File Size" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifFileSize" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Format" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifFormat" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Color Space" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifColorSpace" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Additional Shooting Conditions Card -->
                        <Border Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="SHOOTING CONDITIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,3">
                                    <TextBlock Text="Flash" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifFlash" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="White Balance" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifWhiteBalance" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Metering" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifMetering" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Program" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="ExifProgram" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GPS Location Card -->
                        <Border x:Name="CardGps" Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="GPS LOCATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />
                                <TextBlock x:Name="ExifGpsCoords" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <Button Click="BtnOpenMap_Click"
                                        Background="#252536"
                                        Foreground="{StaticResource AccentBrush}"
                                        BorderThickness="0"
                                        Padding="12,6"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconMap}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                        <TextBlock Text="View on Google Maps" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Complete Raw Tag Tree (All Tags Explorer) -->
                        <Border Background="#181822" CornerRadius="12" BorderBrush="#262636" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ALL METADATA TAGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                                <TextBox x:Name="TxtTagSearch"
                                         TextChanged="TxtTagSearch_TextChanged"
                                         Background="#20202C"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="#333346"
                                         BorderThickness="1"
                                         Padding="8,5"
                                         FontSize="12"
                                         Margin="0,0,0,10" />

                                <ItemsControl x:Name="ItemsExifGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding DirectoryName}" IsExpanded="False" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6">
                                                <ItemsControl ItemsSource="{Binding Tags}" Margin="8,4,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="130" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding TagName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TagName}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding TagValue}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Loading Spinner Indicator (Non-blocking, top right) -->
        <Border x:Name="LoadingBadge"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,52,24,0"
                Background="#D91E1E28"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12,6"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡ Loading..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
